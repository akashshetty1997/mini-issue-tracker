# Copy to .env to override defaults. Every value below is optional:
# docker-compose.yml falls back to these same defaults when .env is absent.

# --- Postgres ---
POSTGRES_USER=issues
POSTGRES_PASSWORD=issues
POSTGRES_DB=issue_tracker
DB_HOST_PORT=5433

# --- API ---
API_HOST_PORT=8000
# Must include the web app's origin.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
# Per client IP; reads and writes are counted separately.
READ_RATE_LIMIT=120/minute
WRITE_RATE_LIMIT=30/minute
# Proxies whose X-Forwarded-For is trusted for the client IP (comma-separated, or *).
TRUSTED_PROXIES=127.0.0.1

# --- Web ---
WEB_HOST_PORT=3000
# Baked into the browser bundle at build time; rebuild the web image after changing it.
# Defaults to http://localhost:${API_HOST_PORT}.
# NEXT_PUBLIC_API_URL=http://localhost:8000
