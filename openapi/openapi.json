    "/ready": {
      "get": {
        "description": "Only the database decides readiness. The rate-limit store is reported but can't\nmake the instance unready: without it the limiter degrades to in-memory counters, and\ntaking healthy instances out of rotation over it would cause an outage.",
        "operationId": "ready_ready_get",
        "responses": {
