          "resolved",
          "closed"
        ],
        "title": "IssueStatus",
        "type": "string"
      },
      "IssueUpdate": {
        "additionalProperties": false,
        "description": "Partial update. Only fields present in the request body are changed.\n\n- title/status/priority: may be omitted, but not set to null\n- description: null is treated as an empty description\n- assignee_id: null unassigns the issue\n- version: required; the version the client last read (optimistic locking)",
        "properties": {
          "assignee_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 2147483647.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "priority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IssuePriority"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IssueStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "version": {
            "description": "Version of the issue being edited",
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "title": "IssueUpdate",
        "type": "object"
      },
      "MetaRead": {
        "description": "Reference data so clients don't hard-code the server's rules.",
        "properties": {
          "default_sort": {
            "title": "Default Sort",
            "type": "string"
          },
          "limits": {
